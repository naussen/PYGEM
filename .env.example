# Identificação do projeto; não coloque credenciais ou chaves neste arquivo.
GOOGLE_CLOUD_PROJECT=seu-id-de-projeto
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_API_VERSION=v1

# Perfil recomendado para reescrita jurídica. Ambos os modelos são GA.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_RECOVERY_MODEL=gemini-3.5-flash
GOOGLE_CLOUD_RECOVERY_LOCATION=global
PYGEM_THINKING_LEVEL=MINIMAL

# Segurança operacional para arquivos grandes.
PYGEM_MAX_OUTPUT_TOKENS_PER_REQUEST=8192
PYGEM_MAX_API_CALLS_PER_ROOT_BLOCK=8
PYGEM_MAX_API_CALLS_PER_FILE_MULTIPLIER=2.5
PYGEM_MAX_API_CALLS_PER_FILE_RESERVE=4
PYGEM_CHECKPOINT_ENABLED=true
PYGEM_MAX_CONCURRENT_REQUESTS=1
PYGEM_AUTO_SHUTDOWN=false
