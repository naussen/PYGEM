{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proconcursos.local/schemas/visual-plan-v1.json",
  "title": "Plano visual PYGEM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "discipline",
    "guide_id",
    "guide_sha256",
    "diversification_seed",
    "topics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "discipline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "guide_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "guide_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "diversification_seed": { "type": "string", "minLength": 1, "maxLength": 200 },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/topic" }
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_title", "topic_slug", "requirements"],
      "properties": {
        "source_index": { "type": "string", "pattern": "^[0-9]{3}$" },
        "guide_section_index": { "type": "integer", "minimum": 1 },
        "canonical_title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "topic_slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 300
        },
        "requirements": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/requirement" }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "semantic_role",
        "required",
        "minimum",
        "maximum"
      ],
      "properties": {
        "resource": {
          "enum": ["table", "mermaid", "highlight", "mnemonic"]
        },
        "semantic_role": {
          "enum": [
            "comparison",
            "classification",
            "timeline",
            "decision_flow",
            "process_flow",
            "hierarchy",
            "rule",
            "exception",
            "critical_order",
            "memory_key"
          ]
        },
        "required": { "type": "boolean" },
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 1 },
        "target_section": { "type": "string", "minLength": 1, "maxLength": 300 },
        "variant_family": {
          "enum": [
            "criteria-as-rows",
            "entities-as-rows",
            "split-comparison",
            "rule-consequence",
            "linear-stages",
            "decision-first",
            "root-branches",
            "phase-groups",
            "warning-before",
            "summary-after",
            "keyword-rule",
            "exception-block",
            "source-preserved"
          ]
        }
      }
    }
  }
}
