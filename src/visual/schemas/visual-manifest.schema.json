{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proconcursos.local/schemas/visual-manifest-v1.json",
  "title": "Manifesto visual de execução PYGEM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source_file",
    "output_file",
    "source_sha256",
    "output_sha256",
    "visual_plan_sha256",
    "topics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["complete", "incomplete", "invalid"] },
    "source_file": { "type": "string", "minLength": 1, "maxLength": 255 },
    "output_file": { "type": "string", "minLength": 1, "maxLength": 255 },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "visual_plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_slug",
          "selected_variants",
          "requirements",
          "observed_resources",
          "violations"
        ],
        "properties": {
          "topic_slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 300
          },
          "selected_variants": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["resource", "semantic_role", "variant_family"],
              "properties": {
                "resource": { "type": "string", "minLength": 1 },
                "semantic_role": { "type": "string", "minLength": 1 },
                "variant_family": { "type": "string", "minLength": 1 }
              }
            }
          },
          "requirements": { "type": "array", "maxItems": 16, "items": { "type": "object" } },
          "observed_resources": { "type": "array", "maxItems": 16, "items": { "type": "object" } },
          "violations": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string", "minLength": 1 },
                "message": { "type": "string", "minLength": 1 },
                "requirement_index": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
